public static void main(String[] args) {
        System.out.println(longestNoRepeat("abcabcbb"));
        System.out.println(slidingMax(new int[]{1, 3, -1, -3, 5, 3, 6, 7}, 3));
        System.out.println(Arrays.toString(dailyTemps(new int[]{73, 74, 75, 71, 69, 72, 76, 73})));
        System.out.println(subarraySum(new int[]{1, 1, 1}, 2));
        System.out.println(isValid("()[]{}"));
        System.out.println(Arrays.toString(twoSum(new int[]{2, 7, 11, 15}, 9)));
        LRUCache lru = new LRUCache(2);
        lru.put(1, 1);
        lru.put(2, 2);
        System.out.println("LRU get(1): " + lru.get(1));
        lru.put(3, 3);
        System.out.println("LRU get(2): " + lru.get(2));
        System.out.println("KMP matches 'ababc' in 'abababcababc': " + searchKMP("abababcababc", "ababc"));
    }
}